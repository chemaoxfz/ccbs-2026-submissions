import argparse
from html import escape
import json
import math
from pathlib import Path

CASES = {
    "A1": (1.0, 1.0, 1.0),
    "A2": (10.0, 1.0, 0.1),
    "A3": (1.0, 10.0, 0.1),
    "A4": (0.2, 1.0, 2.0),
}
STEP = 1e-4
X0 = 2.0
T_END = 1.0


def binding(q_e, q_s, kd):
    """Return the physical equilibrium and its two total-pool orders."""
    total = q_e + q_s + kd
    discriminant = (q_e - q_s) ** 2 + kd * (2 * (q_e + q_s) + kd)
    c = 2 * q_e * q_s / (total + math.sqrt(discriminant))
    e, s = q_e - c, q_s - c
    assert 0 &lt; c &lt; min(q_e, q_s)
    assert math.isclose(e * s, kd * c, rel_tol=1e-12)
    return c, (kd + s) / (kd + e + s), (kd + e) / (kd + e + s)


def feasible(a, b):
    return 0 &lt; a &lt; 1 and 0 &lt; b &lt; 1 and a + b &gt; 1


def from_orders(a, b, kd):
    """Construct totals realizing an interior order pair at the chosen affinity."""
    assert feasible(a, b)
    e = kd * (1 - a) / (a + b - 1)
    s = kd * (1 - b) / (a + b - 1)
    c = e * s / kd
    return e + c, s + c


def numerical_orders(rate, q_e, q_s):
    lo, hi = math.exp(-STEP), math.exp(STEP)
    return (
        (math.log(rate(q_e * hi, q_s)) - math.log(rate(q_e * lo, q_s))) / (2 * STEP),
        (math.log(rate(q_e, q_s * hi)) - math.log(rate(q_e, q_s * lo))) / (2 * STEP),
    )


def calculate():
    geometry = {}
    for name, (q_e, q_s, kd) in CASES.items():
        c, a, b = binding(q_e, q_s, kd)

        def rate(e, s):
            return binding(e, s, kd)[0]

        a_fd, b_fd = numerical_orders(rate, q_e, q_s)
        error = max(abs(a - a_fd), abs(b - b_fd))
        assert error &lt; 1e-8
        q_e_inv, q_s_inv = from_orders(a, b, kd)
        assert math.isclose(q_e, q_e_inv, rel_tol=1e-10)
        assert math.isclose(q_s, q_s_inv, rel_tol=1e-10)
        geometry[name] = dict(q_e=q_e, q_s=q_s, kd=kd, c=c, a=a, b=b, error=error)

    def candidate(e, s):
        return e ** 0.3 * s ** 0.3

    a_bad, b_bad = 0.3, 0.3
    for exact, numeric in zip((a_bad, b_bad), numerical_orders(candidate, 1.0, 1.0)):
        assert abs(exact - numeric) &lt; 1e-8
    assert not feasible(a_bad, b_bad)
    geometry["B"] = dict(a=a_bad, b=b_bad)

    q_e, q_s, kd = CASES["A1"]
    c, a, b = binding(q_e, q_s, kd)
    interface = {}
    for name, k_out in (("C", 3.0), ("D", 1.0)):
        v_in, v_out = c, k_out * c

        def outflow(e, s):
            return k_out * binding(e, s, kd)[0]

        for exact, numeric in zip((a, b), numerical_orders(outflow, q_e, q_s)):
            assert abs(exact - numeric) &lt; 1e-8
        net = v_in - v_out
        interface[name] = dict(v_in=v_in, v_out=v_out, net=net, end=X0 + T_END * net)

    feedback = {}
    for gamma in (1, 3):
        def rhs(x):
            z = x / X0
            return c * (z**2 - z**gamma)

        slope = c * (2 - gamma) / X0
        step = 1e-5 * X0
        assert rhs(X0) == 0
        assert math.isclose(slope, (rhs(X0 + step) - rhs(X0 - step)) / (2 * step),
                            rel_tol=1e-8)
        feedback[gamma] = slope

    return dict(geometry=geometry, interface=interface, feedback=feedback,
                max_error=max(geometry[name]["error"] for name in CASES))


def svg(height, description, body):
    # Fall back to the light palette when the SVG is opened outside the essay.
    colors = {
        "fg": "#242321", "muted": "#6e675f", "bg2": "#ffffff", "bg": "#fcfaf7",
        "powder": "#d0dae4", "teal": "#1f9a8e", "peri": "#5a73ce",
        "rose": "#d75567", "gridc": "#eae6df",
    }
    marks = "\n".join(body)
    for name, color in colors.items():
        marks = marks.replace(f"var(--{name})", f"var(--{name},{color})")
    styles = """
