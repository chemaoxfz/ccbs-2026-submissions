<script>
(() => {
  const root = document.documentElement;
  const toggle = document.getElementById('tt');
  const preference = matchMedia('(prefers-color-scheme: dark)');
  function darkActive() {
    return root.dataset.theme ? root.dataset.theme === 'dark' : preference.matches;
  }
  function updateToggle() {
    const label = darkActive() ? 'Switch to light theme' : 'Switch to dark theme';
    toggle.title = label;
    toggle.setAttribute('aria-label', label);
  }
  toggle.addEventListener('click', () => {
    root.dataset.theme = darkActive() ? 'light' : 'dark';
    updateToggle();
  });
  preference.addEventListener('change', updateToggle);
  updateToggle();

  const links = [...document.querySelectorAll('nav.toc a')];
  const targets = links.map(link => document.getElementById(link.hash.slice(1)));
  function markLocation() {
    let current = 0;
    targets.forEach((target, i) => {
      if (target.getBoundingClientRect().top <= 80) current = i;
    });
    if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 3) {
      current = targets.length - 1;
    }
    links.forEach((link, i) => {
      link.classList.toggle('on', i === current);
      if (i === current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  window.addEventListener('scroll', markLocation, {passive: true});
  window.addEventListener('resize', markLocation);
  markLocation();

  const download = document.getElementById('download-code');
  download.style.display = 'inline-block';
  download.addEventListener('click', () => {
    const source = document.getElementById('python-source').textContent;
    const url = URL.createObjectURL(new Blob([source], {type: 'text/x-python;charset=utf-8'}));
    const link = document.createElement('a');
    link.href = url;
    link.download = 'reproduce.py';
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
})();
</script>
